# Kopiere diese Datei nach server/.env. Die .env gehoert nicht ins Git.

# Datenquelle: "mock" (liest server/data/news.json) oder "sharepoint"
DATA_SOURCE=mock

# Port des Backends (der Vite-Dev-Server leitet /api hierhin weiter)
PORT=3001

# Kuenstliche Verzoegerung der API in Millisekunden (zeigt Ladezustaende)
API_DELAY_MS=600

# App-Registrierung (Public Client, delegierte Berechtigung Sites.Selected)
# Werte erhaeltst du von der Betreuung
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# SharePoint (Site-URL ist gegeben, weitere Werte ermittelst du selbst)
SHAREPOINT_SITE_URL=https://viuteam.sharepoint.com/sites/viu-probetag-2027
